APP_NAME=AEGIS
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=sqlite:///./data/aegis.db

GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Local Ollama AI Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Cloud Anthropic Claude AI Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Hybrid AI Routing & Consent
AEGIS_AI_MODE=AUTO
AEGIS_CLOUD_AI_ENABLED=false
AEGIS_AI_TIMEOUT_SECONDS=20
AEGIS_AI_HEALTH_CHECK_INTERVAL=300

RDAP_BASE_URL=https://rdap.org/domain/
ML_MODEL_PATH=ml/model.joblib

SAFE_CACHE_TTL=900
CRITICAL_CACHE_TTL=86400
SUSPICIOUS_CACHE_TTL=180
REQUEST_TIMEOUT=8

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO