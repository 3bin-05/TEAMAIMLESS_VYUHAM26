# ==========================================
# AEGIS Root Git Ignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
firebase-service-account.json
service-account*.json
credentials.json

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Build outputs
frontend/dist/
frontend/dist-ssr/
*.local

# Python runtime & environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Logs & temporary files
*.log
logs/
tmp/
temp/

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# ML source reference & local AI data
backend/ml_source/
.ollama/

